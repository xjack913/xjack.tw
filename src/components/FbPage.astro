---
// 世界頻道的標題列：臉書官方粉專外掛，只放粉專標題（大頭貼、名稱、追蹤按鈕），XJack 2026-10-27 指定。
// tabs 留空不放貼文串：沒登入臉書的訪客看不到外掛裡的貼文，貼文改由 FbFeed 自己做。
// 外掛的寬度只在載入時決定（180–500），所以等量到容器寬度才放 src，手機上才不會被裁掉。
import { links } from '../data/site';
---

<div class="fb-page" data-href={links.facebook.url}>
  <iframe title="叉傑克 XJack 的 Facebook 粉絲專頁" height="130" scrolling="no" loading="lazy" allow="encrypted-media"></iframe>
  <noscript><a href={links.facebook.url} rel="noopener" target="_blank">{links.facebook.label}</a></noscript>
</div>

<script is:inline>
  document.querySelectorAll('.fb-page').forEach((box) => {
    const frame = box.querySelector('iframe');
    const width = Math.max(180, Math.min(500, Math.floor(box.clientWidth)));
    const params = new URLSearchParams({
      href: box.dataset.href,
      tabs: '',
      width: String(width),
      height: '130',
      small_header: 'false',
      adapt_container_width: 'true',
      hide_cover: 'false',
      show_facepile: 'false',
    });
    frame.width = String(width);
    frame.src = `https://www.facebook.com/plugins/page.php?${params}`;
  });
</script>

<style>
  .fb-page {
    width: min(100%, 500px);
    min-height: 130px;
  }

  iframe {
    display: block;
    max-width: 100%;
    border: 0;
    overflow: hidden;
  }
</style>
