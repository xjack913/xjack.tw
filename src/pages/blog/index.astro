---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/blog';
import { links } from '../../data/site';

const posts = await getPosts();
// 粉專長文另外講，其他是以前的部落格
const fbOrigin = '叉傑克 XJack 粉專';
const origins = [...new Set(posts.map((p) => p.data.origin).filter((o) => o && o !== fbOrigin))];
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.date.getFullYear();
  byYear.set(y, [...(byYear.get(y) ?? []), p]);
}
---

<Base title="冒險日誌" description="叉傑克 XJack 十年來寫的訓練日誌、比賽心得、馬拉松數據分析、創業、育兒與投資文章。">
  <section class="section">
    <div class="wrap">
      <header class="page-head read">
        <h1>冒險日誌</h1>
        <p class="muted">
          以前寫在{origins.map((o) => `「${o}」`).join('、')}的日誌，和{' '}
          <a href={links.facebook.url} rel="noopener" target="_blank">Facebook 粉絲專頁</a>上的長文，都收在這裡，一共{' '}
          <span class="num">{posts.length}</span> 篇，保留當年的文字與語氣；部分照片與連結因隱私和搬家調整過。
        </p>
      </header>
      {
        [...byYear.entries()].map(([year, list]) => (
          <section class="year" aria-labelledby={`y${year}`}>
            <h2 id={`y${year}`} class="num year-label">{year}</h2>
            <PostList posts={list} />
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .page-head {
    margin-bottom: 2.5rem;
  }

  .page-head h1 {
    margin-bottom: 0.6rem;
  }

  .year {
    display: grid;
    grid-template-columns: 7rem 1fr;
    gap: 1rem 2rem;
    border-top: 1px solid var(--rule);
    padding-top: 1.5rem;
    margin-top: 1.5rem;
  }

  .year-label {
    font-family: var(--font-num);
    font-weight: 600;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--navy);
  }

  @media (max-width: 680px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
