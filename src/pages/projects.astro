---
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { projects } from '../data/projects';
import { pageDescriptions } from '../data/site';
---

<Base title="裝備" description={pageDescriptions.projects}>
  <section class="section">
    <div class="wrap">
      <header class="page-head read">
        <h1>裝備欄</h1>
        <p class="muted">
          這些是我一路打造出來、你現在就點得到的東西。有工作做的、陪家人做的，也有純粹自己好玩做的。品質是我自己評的，傳說級只有一件。
        </p>
      </header>
      <div class="list">
        {projects.map((p) => <ProjectRow project={p} level={2} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    margin-bottom: 2.5rem;
  }

  .page-head h1 {
    margin-bottom: 0.6rem;
  }

  .list {
    display: grid;
    gap: 1.75rem;
  }
</style>
