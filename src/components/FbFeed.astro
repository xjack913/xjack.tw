---
// 首頁「世界頻道」：粉專最新貼文。資料由 scripts/sync-fb-latest.mjs 產生。
// 不用臉書官方嵌入：沒登入臉書的訪客只會看到空框。
import feed from '../data/fb-latest.json';

const fmt = new Intl.DateTimeFormat('zh-TW', {
  timeZone: 'Asia/Taipei',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const date = (iso: string) => fmt.format(new Date(iso)).replaceAll('/', '.');
---

<ol class="feed">
  {
    feed.posts.map((p) => (
      <li>
        <a class="post" href={p.url} rel="noopener" target="_blank">
          {p.image && <img src={p.image} alt="" loading="lazy" decoding="async" width="720" height="900" />}
          <span class="body">
            <time class="num" datetime={p.date}>{date(p.date)}</time>
            <span class="text">{p.text}</span>
            <span class="go">看完整貼文</span>
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .feed {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .post {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--paper);
    border: var(--frame);
    border-radius: 12px;
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
  }

  .post:hover {
    color: var(--ink);
  }

  img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: top;
    border-bottom: var(--frame);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
    padding: 0.9rem 1.1rem 1.1rem;
  }

  time {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--slate);
  }

  .text {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  .go {
    margin-top: auto;
    padding-top: 0.25rem;
    font-weight: 700;
    color: var(--navy);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
    text-decoration-color: var(--orange);
  }

  .post:hover .go {
    color: var(--ember);
  }

  @media (max-width: 820px) {
    .feed {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .post {
      flex-direction: row;
    }

    img {
      width: 7.5rem;
      flex: none;
      border-bottom: 0;
      border-right: var(--frame);
    }

    .body {
      padding: 0.75rem 0.9rem;
    }

    .text {
      -webkit-line-clamp: 3;
      line-clamp: 3;
    }
  }
</style>
