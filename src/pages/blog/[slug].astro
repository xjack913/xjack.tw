---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, postSlug, postUrl, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const iso = post.data.date.toISOString().slice(0, 10);
// 分享圖另外轉一張 JPG：直接用封面原檔的話，封面若只在內文被轉成 WebP，原始 JPG 不會輸出，FB／LINE 抓到的是 404
const cover = post.data.cover;
const ogImage = cover ? (await getImage({ src: cover, width: Math.min(1200, cover.width), format: 'jpg' })).src : undefined;
---

<Base title={post.data.title} description={post.data.excerpt} type="article" published={iso} image={ogImage}>
  <article class="section">
    <div class="wrap">
      <header class="head read">
        <p class="crumb"><a href="/blog/">冒險日誌</a></p>
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time class="num" datetime={iso}>{formatDate(post.data.date)}</time>
          {
            post.data.origin && (
              <span class="muted">
                原刊於
                {post.data.originalUrl && !post.data.originalUrl.includes('xjack.tw/') ? (
                  <a href={post.data.originalUrl} target="_blank" rel="noopener">
                    「{post.data.origin}」
                  </a>
                ) : (
                  `「${post.data.origin}」`
                )}
              </span>
            )
          }
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <nav class="pager read" aria-label="上一篇與下一篇">
        {
          older ? (
            <a href={postUrl(older)} rel="prev">
              <span class="muted">較舊的一篇</span>
              <span class="t">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer ? (
            <a href={postUrl(newer)} rel="next" class="right">
              <span class="muted">較新的一篇</span>
              <span class="t">{newer.data.title}</span>
            </a>
          ) : null
        }
      </nav>
    </div>
  </article>
</Base>

<style>
  .head {
    margin-bottom: 2.5rem;
  }

  .crumb {
    margin-bottom: 0.6rem;
    font-weight: 500;
  }

  h1 {
    font-size: var(--step-3);
    margin-bottom: 0.8rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
  }

  .meta time {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--navy);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
  }

  .pager .right {
    text-align: right;
  }

  .pager .t {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
  }

  .pager a:hover .t {
    text-decoration: underline;
    text-decoration-color: var(--orange);
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .right {
      text-align: left;
    }
  }
</style>
