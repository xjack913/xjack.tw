---
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, postSlug, postSummary, postUrl, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: postSlug(post) },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const iso = post.data.date.toISOString().slice(0, 10);
// 分享圖另外轉一張 JPG：直接用封面原檔的話，封面若只在內文被轉成 WebP，原始 JPG 不會輸出，FB／LINE 抓到的是 404
const cover = post.data.cover;
const ogImage = cover ? (await getImage({ src: cover, width: Math.min(1200, cover.width), format: 'jpg' })).src : undefined;
const summary = postSummary(post);

// 文章與麵包屑的結構化資料；作者指回 Base 裡的人物 @id
const url = new URL(postUrl(post), Astro.site).href;
const personRef = { '@type': 'Person', '@id': new URL('/#person', Astro.site).href, name: '叉傑克 XJack', url: Astro.site?.href };
// 舊站文章的原文網址就是這個網域，不算「改寫自別處」
const original = post.data.originalUrl && !post.data.originalUrl.includes('xjack.tw/') ? post.data.originalUrl : undefined;
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.data.title,
    description: summary,
    datePublished: iso,
    inLanguage: 'zh-Hant-TW',
    url,
    mainEntityOfPage: url,
    image: new URL(ogImage ?? '/og.jpg', Astro.site).href,
    author: personRef,
    publisher: personRef,
    ...(post.data.tags.length && { keywords: post.data.tags.join(', ') }),
    ...(original && { isBasedOn: original }),
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: '冒險日誌', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: post.data.title },
    ],
  },
];
---

<Base title={post.data.title} description={summary} type="article" published={iso} image={ogImage} jsonLd={jsonLd}>
  <article class="section">
    <div class="wrap">
      <header class="head read">
        <p class="crumb"><a href="/blog/">冒險日誌</a></p>
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time class="num" datetime={iso}>{formatDate(post.data.date)}</time>
          {
            post.data.origin && (
              <span class="muted">
                原刊於
                {post.data.originalUrl && !post.data.originalUrl.includes('xjack.tw/') ? (
                  <a href={post.data.originalUrl} target="_blank" rel="noopener">
                    「{post.data.origin}」
                  </a>
                ) : (
                  `「${post.data.origin}」`
                )}
              </span>
            )
          }
        </p>
      </header>
      <div class="prose">
        <Content />
      </div>
      <nav class="pager read" aria-label="上一篇與下一篇">
        {
          older ? (
            <a href={postUrl(older)} rel="prev">
              <span class="muted">較舊的一篇</span>
              <span class="t">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          newer ? (
            <a href={postUrl(newer)} rel="next" class="right">
              <span class="muted">較新的一篇</span>
              <span class="t">{newer.data.title}</span>
            </a>
          ) : null
        }
      </nav>
    </div>
  </article>
</Base>

<style>
  /* 閱讀欄比 .wrap 窄，置中才不會在寬螢幕上貼左邊、右邊空一大塊 */
  .head,
  .prose,
  .pager {
    margin-inline: auto;
  }

  .head {
    margin-bottom: 2.5rem;
  }

  .crumb {
    margin-bottom: 0.6rem;
    font-weight: 500;
  }

  h1 {
    font-size: var(--step-3);
    margin-bottom: 0.8rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
  }

  .meta time {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--navy);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .pager a {
    display: grid;
    gap: 0.2rem;
    text-decoration: none;
  }

  .pager .right {
    text-align: right;
  }

  .pager .t {
    font-family: var(--font-head);
    font-weight: 700;
    color: var(--navy);
  }

  .pager a:hover .t {
    text-decoration: underline;
    text-decoration-color: var(--orange);
  }

  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager .right {
      text-align: left;
    }
  }
</style>
