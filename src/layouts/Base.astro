---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person, links, analyticsId } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: string;
  /** 結構化資料帶本名：關於我和首頁（2026-10-30 XJack：本名要讓搜尋引擎跟叉傑克連起來） */
  fullIdentity?: boolean;
  /** 這一頁另外的結構化資料（文章、麵包屑等），跟全站的人物、網站資料放在同一個 @graph */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description = `${person.intro}${person.motto}`,
  image = '/og.jpg',
  type = 'website',
  published,
  fullIdentity = false,
  jsonLd = [],
} = Astro.props;

const siteTitle = `${person.name} ${person.nameEn}`;
// 首頁的搜尋結果標題多帶本名和一句身分：搜本名的人找得到，光「XJack」也太容易跟別人撞名
const fullTitle = title ? `${title}｜${siteTitle}` : `${siteTitle}（${person.realName}）｜${person.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// 驗收用的子網域不讓搜尋引擎收錄，正式網域才開放
const indexable = Astro.site?.hostname === 'xjack.tw';
const ogImage = new URL(image, Astro.site);

// 用固定的 @id 串起來：文章的作者、關於我頁的主角都指回同一個人
const personId = new URL('/#person', Astro.site).href;
const personLd = {
  '@type': 'Person',
  '@id': personId,
  name: siteTitle,
  alternateName: [...(fullIdentity ? [person.realName, person.realNameEn] : []), person.nameEn, 'XJack Hsu'],
  description: person.intro,
  url: Astro.site?.href,
  image: new URL('/images/xjack-portrait.jpg', Astro.site).href,
  jobTitle: 'RQ 跑力共同創辦人暨執行長',
  worksFor: { '@type': 'Organization', name: 'RQ 跑力（RunningQuotient）', url: links.rq.url },
  alumniOf: { '@type': 'CollegeOrUniversity', name: '國立東華大學' },
  knowsAbout: person.knowsAbout,
  // LinkedIn 網址裡有本名，跟 alternateName 一樣只在帶本名的頁面放
  sameAs: [links.facebook.url, links.instagram.url, links.youtube.url, links.medium.url, ...(fullIdentity ? [links.linkedin.url] : []), links.github.url],
};
// 網站名稱：Google 搜尋結果上方顯示的站名
const websiteLd = {
  '@type': 'WebSite',
  '@id': new URL('/#website', Astro.site).href,
  name: siteTitle,
  alternateName: [person.nameEn, person.name],
  url: Astro.site?.href,
  inLanguage: 'zh-Hant-TW',
  publisher: { '@id': personId },
};
const graph = { '@context': 'https://schema.org', '@graph': [personLd, websiteLd, ...jsonLd] };
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteTitle} />
    <link rel="canonical" href={canonical} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${person.name}的文章`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1e3a5f" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={title ?? siteTitle} />
    <meta property="og:locale" content="zh_TW" />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Noto+Sans+TC:wght@400;500;700;900&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    {/* GA4 只在建置出來的網站載入，本機開發不記 */}
    {
      import.meta.env.PROD && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${analyticsId}`} />
          <script is:inline define:vars={{ analyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', analyticsId);
          </script>
        </>
      )
    }
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
