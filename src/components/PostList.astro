---
import { Image } from 'astro:assets';
import { formatDate, postUrl, type Post } from '../lib/blog';

interface Props {
  posts: Post[];
  compact?: boolean;
}
const { posts, compact = false } = Astro.props;
---

<ol class:list={['posts', { compact }]}>
  {
    posts.map((post) => (
      <li class="post">
        <a class="hit" href={postUrl(post)}>
          {post.data.cover && !compact ? (
            <Image class="cover" src={post.data.cover} alt="" width={320} height={200} fit="cover" loading="lazy" />
          ) : null}
          <span class="body">
            <span class="meta">
              <time class="num date" datetime={post.data.date.toISOString().slice(0, 10)}>
                {formatDate(post.data.date)}
              </time>
              {post.data.origin && !compact ? <span class="origin">{post.data.origin}</span> : null}
            </span>
            <span class="title">{post.data.title}</span>
            {post.data.excerpt && !compact ? <span class="excerpt">{post.data.excerpt}</span> : null}
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .hit {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: 1.25rem;
    align-items: start;
    padding: 0.9rem 0;
    text-decoration: none;
    color: var(--ink);
  }

  .compact .hit {
    grid-template-columns: 1fr;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .hit:not(:has(.cover)) {
    grid-template-columns: 1fr;
  }

  .cover {
    width: 160px;
    height: 100px;
    object-fit: cover;
    border-radius: 4px;
    background: var(--mist);
  }

  .body {
    display: grid;
    gap: 0.15rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.75rem;
    align-items: baseline;
  }

  .origin {
    font-size: 0.9rem;
    color: var(--slate);
  }

  .date {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--slate);
  }

  .title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--navy);
  }

  .hit:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .excerpt {
    color: var(--slate);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 560px) {
    .hit {
      grid-template-columns: 96px 1fr;
      gap: 0.9rem;
    }

    .cover {
      width: 96px;
      height: 72px;
    }

    .excerpt {
      display: none;
    }
  }
</style>
