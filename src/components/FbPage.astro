---
// 世界頻道的標題列：粉專的大頭貼、名稱和「追蹤粉專」按鈕，網站自己做（XJack 2026-10-28 指定）。
// 不用臉書官方粉專外掛：2026-10-28 試了 6 種參數，封面都載不出來、追蹤人數被按鈕列壓住，有沒有登入都一樣。
import { links } from '../data/site';
---

<div class="fb-page">
  <img src="/images/xjack-portrait.jpg" alt="" width="56" height="56" decoding="async" />
  <div class="who">
    <p class="name">叉傑克 XJack</p>
    <p class="where">Facebook 粉絲專頁</p>
  </div>
  <a class="btn" href={links.facebook.url} rel="noopener" target="_blank">追蹤粉專</a>
</div>

<style>
  .fb-page {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: min(100%, 30rem);
    padding: 0.75rem 1rem;
    background: var(--paper);
    border: var(--frame);
    border-radius: 12px;
  }

  img {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--navy);
    object-fit: cover;
  }

  .who {
    flex: 1;
    min-width: 0;
  }

  .who p {
    margin: 0;
  }

  .name {
    font-family: var(--font-head);
    font-weight: 900;
    font-size: var(--step-1);
    line-height: 1.3;
    color: var(--navy);
  }

  .where {
    font-size: var(--step--1);
    color: var(--slate);
  }

  .btn {
    flex: none;
  }

  /* 手機上名字和按鈕擠一排會斷行，按鈕改放第二行、整排寬 */
  @media (max-width: 480px) {
    .fb-page {
      flex-wrap: wrap;
    }

    .btn {
      flex: 1 1 100%;
      justify-content: center;
    }
  }
</style>
