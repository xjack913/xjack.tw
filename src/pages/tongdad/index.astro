---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { links, pageDescriptions } from '../../data/site';
import { comicUrl, getComics, monthLabel, type Comic } from '../../lib/tongdad';

const comics = await getComics();
// 依月份分段，新的月份在前
const byMonth = new Map<string, Comic[]>();
for (const c of comics) {
  const key = monthLabel(c.data.date);
  byMonth.set(key, [...(byMonth.get(key) ?? []), c]);
}
const jsonLd = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首頁', item: Astro.site?.href },
      { '@type': 'ListItem', position: 2, name: '桐爸日記' },
    ],
  },
];
---

<Base title="桐爸日記" description={pageDescriptions.tongdad} jsonLd={jsonLd}>
  <section class="section">
    <div class="wrap">
      <header class="page-head read">
        <h1>桐爸日記</h1>
        <p class="muted">
          把桐桐每天冒出來的金句和家裡的小事畫成漫畫，每週一、四在{' '}
          <a href={links.facebook.url} rel="noopener" target="_blank">Facebook 粉絲專頁</a>連載，一共{' '}
          <span class="num">{comics.length}</span> 篇。素材由桐桐無償提供，爸爸負責被吐槽。
        </p>
      </header>
      {
        [...byMonth].map(([month, list]) => (
          <section class="month" aria-label={month}>
            <h2 class="num">{month}</h2>
            <ol class="grid">
              {list.map((c) => (
                <li>
                  <a class="card" href={comicUrl(c)}>
                    <span class="frame-img">
                      <Image src={c.data.image} alt="" width={360} height={450} fit="cover" position="top" loading="lazy" />
                    </span>
                    <span class="title">{c.data.title}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .page-head {
    margin-bottom: 2.5rem;
  }

  .month + .month {
    margin-top: 3rem;
  }

  .month h2 {
    font-size: var(--step-2);
    margin-bottom: 1rem;
    color: var(--navy);
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 960px) {
    .grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
  }

  .card {
    display: grid;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }

  .frame-img {
    display: block;
    border: var(--frame);
    border-radius: 6px;
    overflow: hidden;
    background: var(--mist);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .frame-img :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
  }

  .card:hover .frame-img,
  .card:focus-visible .frame-img {
    box-shadow: var(--frame-shadow);
    transform: translate(-2px, -2px);
  }

  .title {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step--1);
    line-height: 1.5;
    color: var(--navy);
  }

  .card:hover .title {
    text-decoration: underline;
    text-decoration-color: var(--orange);
  }

  @media (prefers-reduced-motion: reduce) {
    .frame-img {
      transition: none;
    }

    .card:hover .frame-img,
    .card:focus-visible .frame-img {
      transform: none;
    }
  }
</style>
