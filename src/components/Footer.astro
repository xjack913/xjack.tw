---
import { links, person } from '../data/site';
import Mark from './Mark.astro';

const year = new Date().getFullYear();
const list = [links.facebook, links.instagram, links.youtube, links.medium, links.github, links.rq];
---

<footer class="site-footer">
  <div class="wrap grid">
    <div class="sign">
      <Mark size={44} tone="white" />
      <div>
        <p class="motto">{person.belief}</p>
        <p class="small">© {year} {person.name} {person.nameEn}。存檔完成，下次見。</p>
      </div>
    </div>
    <nav aria-label="社群連結">
      <ul>
        {
          list.map((l) => (
            <li>
              <a href={l.url} rel="me noopener" target="_blank">
                {l.label}
              </a>
            </li>
          ))
        }
        <li><a href="/rss.xml">RSS 訂閱</a></li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: #e6ecf3;
    padding-block: 2.5rem 2rem;
    margin-top: 2rem;
  }

  .grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }

  .sign {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .motto {
    font-family: var(--font-head);
    font-weight: 700;
    font-size: var(--step-1);
    color: #ffffff;
    margin-bottom: 0.4rem;
    line-height: 1.5;
  }

  .small {
    font-size: var(--step--1);
    margin: 0;
    color: #c9d3e0;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    max-width: 30rem;
  }

  a {
    color: #ffffff;
    text-decoration-color: var(--orange);
  }

  a:hover {
    color: #ffd0bc;
  }
</style>
