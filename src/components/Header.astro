---
import { nav, person } from '../data/site';
import Mark from './Mark.astro';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label={`${person.name} ${person.nameEn} 首頁`}>
      <Mark size={30} />
      <span class="brand-name">{person.name}</span>
      <span class="brand-en num">{person.nameEn}</span>
    </a>
    <nav aria-label="主要選單">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
    background: var(--paper);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    padding-block: 0.9rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    color: var(--navy);
  }

  .brand-name {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
  }

  .brand-en {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--slate);
  }

  ul {
    display: flex;
    gap: 0.25rem 1.4rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding: 0.35rem 0;
    text-decoration: none;
    font-weight: 500;
    color: var(--ink);
    border-bottom: 3px solid transparent;
  }

  nav a:hover {
    color: var(--navy);
    border-bottom-color: var(--rule);
  }

  nav a[aria-current='page'] {
    color: var(--navy);
    border-bottom-color: var(--orange);
  }

  @media (max-width: 560px) {
    .bar {
      padding-block: 0.75rem 0.25rem;
    }

    nav {
      width: 100%;
    }

    ul {
      justify-content: space-between;
      gap: 0;
    }
  }
</style>
