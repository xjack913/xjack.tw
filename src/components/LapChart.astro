---
// 首頁的招牌圖：把每一年當成跑錶上的一圈分段。
// 柱高＝那一年記下幾件事（平方根比例，避免事情特別多的一年把其他年壓扁；確切件數標在柱子上），
// 橘點＝那一年有重要時刻，下面寫那一年的代表事件。
import { laps } from '../lib/milestones';

const all = laps();
const max = Math.max(...all.map((l) => l.count));
const height = (count: number) => Math.max(10, Math.sqrt(count / max) * 100);
---

<figure class="laps" aria-labelledby="laps-cap">
  <div class="scroller">
    <ol class="track" style={`--n:${all.length}`}>
      {
        all.map((lap, i) => (
          <li class="lap">
            <a href={`/timeline/#y${lap.year}`} class="hit">
              <span class="bar-zone" aria-hidden="true">
                <span class="bar" style={`--h:${height(lap.count)}%;--i:${i}`}>
                  <span class="count num">{lap.count}</span>
                  {lap.majors > 0 && <span class="pin" />}
                </span>
              </span>
              <span class="year num">{lap.label}</span>
              <span class="what">{lap.headline.short ?? lap.headline.title}</span>
              <span class="visually-hidden">，記了 {lap.count} 件事</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
  <figcaption id="laps-cap" class="muted">
    每一年是跑錶上的一圈：柱子上的數字是那一年解鎖幾個成就，橘點代表那一年有傳說級的時刻。點年份看那一年發生了什麼。
  </figcaption>
</figure>

<style>
  .laps {
    margin: 0;
    /* 依圖表實際寬度切換橫柱／直柱，不看螢幕寬，字體放大時也會跟著切 */
    container: laps / inline-size;
  }

  /* position: relative 讓念給螢幕閱讀器的隱藏字留在框裡，不然平板寬度整頁會被撐寬、左右捲動 */
  .scroller {
    position: relative;
    overflow-x: auto;
    scrollbar-width: thin;
    padding-bottom: 0.5rem;
  }

  .track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    /* 每一年平分寬度，不設最小寬：平板上原本要捲動才看得到最近幾年，觸控又沒有捲軸，看起來像被切掉 */
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 0.25rem;
  }

  .hit {
    display: grid;
    grid-template-rows: 11.5rem auto auto;
    align-content: start;
    gap: 0.25rem;
    height: 100%;
    padding: 0.5rem 0.3rem 0.6rem;
    border-radius: 6px;
    text-decoration: none;
    color: var(--ink);
  }

  .hit:hover {
    background: var(--paper);
  }

  .hit:hover .year {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.2em;
  }

  .bar-zone {
    position: relative;
    display: flex;
    align-items: flex-end;
    padding-top: 1.5rem;
    border-bottom: 3px solid var(--navy);
  }

  .bar {
    position: relative;
    width: 72%;
    height: var(--h);
    background: var(--navy);
    border-radius: 3px 3px 0 0;
    transform-origin: bottom;
    animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 50ms);
  }

  .count {
    position: absolute;
    left: 0;
    right: 0;
    top: 0.2rem;
    text-align: center;
    color: #fff;
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1;
  }

  .pin {
    position: absolute;
    left: 50%;
    top: -1.05rem;
    width: 0.95rem;
    height: 0.95rem;
    margin-left: -0.475rem;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 3px var(--mist);
  }

  .year {
    /* 柱子變窄時年份跟著縮，才不會擠到隔壁；最大維持原本大小 */
    font-size: clamp(1.05rem, 100cqi / var(--n) * 0.33, 1.45rem);
    font-weight: 700;
    line-height: 1;
    color: var(--navy);
    padding-top: 0.4rem;
  }

  .what {
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--slate);
  }

  figcaption {
    font-size: var(--step--1);
    margin-top: 1rem;
  }

  @keyframes rise {
    from {
      transform: scaleY(0);
    }
  }

  /* 手機和直拿的平板：改成一列一年，柱子橫著長 */
  @container laps (max-width: 48rem) {
    .scroller {
      overflow: visible;
    }

    .track {
      grid-template-columns: 1fr;
      min-width: 0;
      gap: 0;
    }

    .hit {
      grid-template-columns: 4rem 1fr;
      grid-template-rows: auto auto;
      column-gap: 0.9rem;
      row-gap: 0.2rem;
      padding: 0.65rem 0;
      border-bottom: 1px solid var(--rule);
      border-radius: 0;
    }

    .bar-zone {
      grid-column: 2;
      grid-row: 1;
      height: 1.3rem;
      border-bottom: 0;
      border-left: 3px solid var(--navy);
      align-items: center;
      padding-top: 0;
      padding-right: 1.6rem;
    }

    .bar {
      width: var(--h);
      min-width: 1.8rem;
      height: 100%;
      border-radius: 0 3px 3px 0;
      transform-origin: left;
      animation-name: grow;
    }

    .count {
      top: 50%;
      transform: translateY(-50%);
      text-align: right;
      right: 0.4rem;
      left: auto;
      font-size: 0.95rem;
    }

    .pin {
      left: auto;
      right: -1.3rem;
      top: 50%;
      margin: -0.475rem 0 0;
    }

    .year {
      grid-column: 1;
      grid-row: 1 / span 2;
      font-size: 1.45rem;
      padding-top: 0;
      align-self: center;
    }

    .what {
      grid-column: 2;
    }
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }
</style>
