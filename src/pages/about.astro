---
// 角色檔案（關於我）：本名只在這一頁出現
import Base from '../layouts/Base.astro';
import { person, links } from '../data/site';
import { profile, story, beliefs, english } from '../data/about';
import { media } from '../data/media';
import { education, publications, patents } from '../data/academic';

const contactLinks = [links.facebook, links.instagram, links.youtube, links.medium, links.linkedin, links.github];
// 個人簡介頁：告訴搜尋引擎這一頁的主角就是 Base 裡的那個人
const profileLd = {
  '@type': 'ProfilePage',
  url: new URL('/about/', Astro.site).href,
  mainEntity: { '@id': new URL('/#person', Astro.site).href },
};
---

<Base
  title="角色檔案"
  fullIdentity
  description={`${person.name} ${person.nameEn}（本名${person.realName}）：${person.intro}`}
  jsonLd={[profileLd]}
>
  <section class="section band">
    <div class="wrap">
      <div class="sheet frame">
        <div class="portrait">
          <img
            src="/images/xjack-portrait.jpg"
            alt="叉傑克穿著 RQ 跑力黑色 T 恤、雙手抱胸的半身照"
            width="960"
            height="960"
          />
          <span class="level num">{person.level}</span>
        </div>
        <div>
          <p class="kicker">角色檔案</p>
          <h1>{person.name} <span class="num">{person.nameEn}</span></h1>
          <dl class="profile">
            {
              profile.map((p) => (
                <div>
                  <dt>{p.label}</dt>
                  <dd>{p.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="block-title">主線劇情</h2>
      <ol class="story">
        {
          story.map((s, i) => (
            <li class="chapter">
              <p class="num idx">第 {i + 1} 章</p>
              <div class="read">
                <h3>{s.heading}</h3>
                {s.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </li>
          ))
        }
      </ol>
      <p class="next read">
        每一關的細節都記在<a href="/timeline/">成就</a>。
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <h2 class="block-title">信條</h2>
      <div class="beliefs">
        {
          beliefs.map((b) => (
            <blockquote>
              <p class="quote">{b.title}</p>
              <p class="muted">{b.text}</p>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="research">
    <div class="wrap">
      <h2 class="block-title">學歷與研究</h2>
      <div class="edu-grid">
        <div>
          <h3 class="sub">學歷</h3>
          <ol class="edu">
            {
              education.map((e) => (
                <li>
                  <span class="num yrs">{e.years}</span>
                  <span>
                    {e.school}
                    <span class="muted">（{e.degree}）</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <h3 class="sub">專利</h3>
          <ul class="plain">
            {
              patents.map((p) => (
                <li>
                  <span class="num yrs">{p.year}</span> {p.title}
                  <span class="muted">（{p.authors}）</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="sub">論文</h3>
          <p class="muted note">東華 GAMELab 時期和戴文凱教授合作的電腦繪圖與遊戲研究，英文署名 Hung-Wei Hsu。</p>
          <ol class="pubs">
            {
              publications.map((p) => (
                <li>
                  <span class="num yrs">{p.year}</span>
                  <span>
                    {p.url ? (
                      <a href={p.url} target="_blank" rel="noopener" lang="en">
                        {p.title}
                      </a>
                    ) : (
                      <span lang="en">{p.title}</span>
                    )}
                    <span class="venue">{p.venue}</span>
                    <span class="muted authors" lang="en">{p.authors}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  {
    media.length > 0 && (
      <section class="section band" id="media">
        <div class="wrap">
          <h2 class="block-title">上過的媒體與舞台</h2>
          <ol class="media">
            {media.map((m) => (
              <li>
                <span class="num date">{m.date.replaceAll('-', '.')}</span>
                <span class="kind">{m.kind}</span>
                <span class="what">
                  {m.url ? (
                    <a href={m.url} target="_blank" rel="noopener">
                      {m.title}
                    </a>
                  ) : (
                    m.title
                  )}
                  {m.outlet && <span class="muted">（{m.outlet}）</span>}
                </span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="section" id="contact">
    <div class="wrap two">
      <div>
        <h2 class="block-title">有事密我</h2>
        <p>演講、訪談、合作邀約，或只是想組隊聊天，私訊我的 Facebook 粉絲專頁最快，我會親自回。</p>
        <ul class="contact">
          {
            contactLinks.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="me noopener">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div lang="en" class="en-bio">
        <h2 class="block-title">In English</h2>
        <p>{english}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .sheet {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: 2rem 3rem;
    padding: clamp(1.25rem, 3vw, 2.25rem);
    align-items: start;
  }

  .portrait {
    position: relative;
  }

  .portrait img {
    width: 100%;
    border-radius: 10px;
    border: var(--frame);
  }

  .level {
    position: absolute;
    right: -0.6rem;
    bottom: -0.8rem;
    background: var(--orange);
    color: var(--ink);
    border: var(--frame);
    border-radius: 999px;
    padding: 0.1rem 0.8rem;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .kicker {
    display: inline-block;
    margin: 0 0 0.4rem;
    padding: 0 0.7rem;
    border-radius: 6px;
    background: var(--orange-soft);
    color: var(--ember);
    font-weight: 700;
    font-size: var(--step--1);
  }

  h1 {
    font-size: var(--step-4);
    line-height: 1.1;
    margin-bottom: 1.25rem;
  }

  h1 .num {
    font-weight: 700;
  }

  .profile {
    margin: 0;
    display: grid;
    gap: 0;
  }

  .profile div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 1rem;
    padding: 0.55rem 0;
    border-top: 1px solid var(--rule);
  }

  .profile dt {
    font-weight: 700;
    color: var(--navy);
  }

  .profile dd {
    margin: 0;
  }

  .block-title {
    margin-bottom: 2rem;
  }

  .story {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }

  .chapter {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1.5rem;
  }

  .idx {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--navy);
    border-top: 6px solid var(--orange);
    padding-top: 0.5rem;
    margin: 0;
  }

  .chapter h3 {
    font-size: var(--step-2);
    font-weight: 900;
    margin-bottom: 0.75rem;
  }

  .next {
    margin-top: 2.5rem;
    font-weight: 700;
  }

  .beliefs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 1.25rem;
  }

  blockquote {
    margin: 0;
    padding: 1rem 1.25rem;
    background: var(--paper);
    border: var(--frame);
    border-radius: 12px;
  }

  .quote {
    font-weight: 900;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--navy);
    margin-bottom: 0.4rem;
  }

  blockquote .muted {
    margin: 0;
  }

  .edu-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 2rem 4rem;
  }

  .sub {
    font-size: var(--step-1);
    margin: 0 0 0.75rem;
  }

  .sub:not(:first-child) {
    margin-top: 2rem;
  }

  .edu,
  .pubs,
  .plain,
  .media {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .edu li,
  .pubs li,
  .plain li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.2rem 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
  }

  .pubs li {
    grid-template-columns: 3.5rem 1fr;
  }

  .plain li {
    display: block;
  }

  .yrs {
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--navy);
  }

  .venue,
  .authors {
    display: block;
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .note {
    font-size: var(--step--1);
  }

  .media li {
    display: grid;
    grid-template-columns: 7.5rem 6rem 1fr;
    gap: 0.25rem 1.25rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--rule);
  }

  .media .date {
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--navy);
  }

  .media .kind {
    font-weight: 700;
    color: var(--ember);
  }

  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 4rem;
  }

  .contact {
    padding-left: 1.2em;
  }

  .en-bio p {
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .sheet {
      grid-template-columns: 1fr;
    }

    .portrait {
      width: min(70%, 15rem);
    }

    .profile div {
      grid-template-columns: 1fr;
    }

    .chapter {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .idx {
      width: 6rem;
    }

    .edu-grid,
    .two {
      grid-template-columns: 1fr;
    }

    .media li {
      grid-template-columns: 1fr;
    }
  }
</style>
