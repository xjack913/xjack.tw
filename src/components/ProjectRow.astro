---
// 裝備卡：像魔獸世界的物品說明框（品質標籤、取得時間、說明、最底下一行小字）
import { qualityLabel, type Project } from '../data/projects';

interface Props {
  project: Project;
  compact?: boolean;
}
const { project: p, compact = false } = Astro.props;
const external = p.url && !p.url.startsWith('/');
---

<article class:list={['item', p.quality, { compact, 'has-image': !!p.image }]} id={p.id}>
  {
    p.image && (
      <a
        class="shot"
        href={p.url}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
        tabindex="-1"
        aria-hidden="true"
      >
        <img src={p.image} alt={p.imageAlt ?? ''} loading="lazy" width="1200" height="630" />
      </a>
    )
  }
  <div class="text">
    <p class="meta">
      <span class:list={['quality', p.quality]}>{qualityLabel[p.quality]}</span>
      <span class="num period">{p.period}</span>
      <span class="status">{p.status}</span>
    </p>
    <h3>{p.name}</h3>
    <p class="summary">{p.summary}</p>
    {p.flavor && !compact && <p class="flavor">「{p.flavor}」</p>}
    {
      p.url && (
        <p class="go">
          <a href={p.url} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
            {p.urlLabel ?? '看看'}
          </a>
        </p>
      )
    }
  </div>
</article>

<style>
  .item {
    display: grid;
    gap: 1rem 2rem;
    background: var(--paper);
    border: var(--frame);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    border-top-width: 8px;
  }

  .item.legendary {
    border-top-color: var(--orange);
  }

  .item.epic {
    border-top-color: #6d3fc0;
  }

  .item.rare {
    border-top-color: #2f6fb8;
  }

  .item.has-image {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    align-items: center;
  }

  .shot img {
    width: 100%;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    border-radius: 8px;
    border: 1px solid var(--rule);
    background: var(--mist);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.9rem;
    align-items: center;
    margin-bottom: 0.3rem;
  }

  .period {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
  }

  .status {
    font-size: var(--step--1);
    color: var(--slate);
  }

  h3 {
    font-size: var(--step-2);
    font-weight: 900;
    margin-bottom: 0.4rem;
  }

  .flavor {
    color: var(--ember);
    font-weight: 500;
  }

  .go {
    font-weight: 700;
    margin: 0;
  }

  @media (max-width: 760px) {
    .item.has-image {
      grid-template-columns: 1fr;
    }
  }
</style>
