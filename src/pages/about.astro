---
import Base from '../layouts/Base.astro';
import { person, links } from '../data/site';
import { story, beliefs, english } from '../data/about';
import { media } from '../data/media';
import { education, publications, patents } from '../data/academic';

const contactLinks = [links.facebook, links.instagram, links.youtube, links.medium, links.linkedin, links.github];
---

<Base title="關於我" fullIdentity description={`${person.realName}（${person.name} ${person.nameEn}）：${person.intro}`}>
  <section class="section intro">
    <div class="wrap intro-grid">
      <img
        class="portrait"
        src="/images/xjack-portrait.jpg"
        alt="叉傑克穿著 RQ 跑力黑色 T 恤、雙手抱胸的半身照"
        width="960"
        height="960"
      />
      <div>
        <h1>關於我</h1>
        <p class="names">
          <span class="hand">{person.name}</span>
          <span class="num">{person.nameEn}</span>
          <span class="muted">本名{person.realName}</span>
        </p>
        <ul class="roles">
          {person.roles.map((r) => <li>{r}</li>)}
        </ul>
        <p class="lede">{person.intro}{person.motto}</p>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <h2 class="block-title">我怎麼走到這裡</h2>
      <div class="story">
        {
          story.map((s, i) => (
            <article class="chapter">
              <p class="num idx" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </p>
              <div class="read">
                <h3>{s.heading}</h3>
                {s.paragraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>
            </article>
          ))
        }
      </div>
      <p class="next read">
        更多細節都記在 <a href="/timeline/">里程碑</a>。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="block-title">我相信的事</h2>
      <div class="beliefs">
        {
          beliefs.map((b) => (
            <blockquote>
              <p class="quote">{b.title}</p>
              <p class="muted">{b.text}</p>
            </blockquote>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" id="research">
    <div class="wrap">
      <h2 class="block-title">學歷與研究</h2>
      <div class="edu-grid">
        <div>
          <h3 class="sub">學歷</h3>
          <ol class="edu">
            {
              education.map((e) => (
                <li>
                  <span class="num yrs">{e.years}</span>
                  <span>
                    {e.school}
                    <span class="muted">（{e.degree}）</span>
                  </span>
                </li>
              ))
            }
          </ol>
          <h3 class="sub">專利</h3>
          <ul class="plain">
            {
              patents.map((p) => (
                <li>
                  <span class="num yrs">{p.year}</span> {p.title}
                  <span class="muted">（{p.authors}）</span>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3 class="sub">論文</h3>
          <p class="muted note">東華 GAMELab 時期和戴文凱教授合作的電腦繪圖與遊戲研究，英文署名 Hung-Wei Hsu。</p>
          <ol class="pubs">
            {
              publications.map((p) => (
                <li>
                  <span class="num yrs">{p.year}</span>
                  <span>
                    {p.url ? (
                      <a href={p.url} target="_blank" rel="noopener" lang="en">
                        {p.title}
                      </a>
                    ) : (
                      <span lang="en">{p.title}</span>
                    )}
                    <span class="venue">{p.venue}</span>
                    <span class="muted authors" lang="en">{p.authors}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
  </section>

  {
    media.length > 0 && (
      <section class="section band" id="media">
        <div class="wrap">
          <h2 class="block-title">媒體、訪談與演講</h2>
          <ol class="media">
            {media.map((m) => (
              <li>
                <span class="num date">{m.date.replaceAll('-', '.')}</span>
                <span class="kind muted">{m.kind}</span>
                <span class="what">
                  {m.url ? (
                    <a href={m.url} target="_blank" rel="noopener">
                      {m.title}
                    </a>
                  ) : (
                    m.title
                  )}
                  {m.outlet && <span class="muted">（{m.outlet}）</span>}
                </span>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <section class="section" id="contact">
    <div class="wrap two">
      <div>
        <h2 class="block-title">聯絡我</h2>
        <p>演講、訪談、合作邀約，或只是想打聲招呼，請私訊我的 Facebook 粉絲專頁，我會親自回覆。</p>
        <ul class="contact">
          {
            contactLinks.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="me noopener">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div lang="en" class="en-bio">
        <h2 class="block-title">In English</h2>
        <p>{english}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 18rem) minmax(0, 1fr);
    gap: 2rem 3.5rem;
    align-items: center;
  }

  .portrait {
    border-radius: 8px;
    box-shadow: 1rem 1rem 0 var(--navy);
  }

  h1 {
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }

  .names {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    align-items: baseline;
    margin-bottom: 0.75rem;
  }

  .names .hand {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--step-2);
    color: var(--navy);
  }

  .names .num {
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--navy);
  }

  .roles {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .roles li {
    border: 2px solid var(--navy);
    border-radius: 999px;
    padding: 0.05rem 0.9rem;
    font-weight: 500;
    color: var(--navy);
    font-size: var(--step--1);
  }

  .lede {
    font-size: var(--step-1);
    line-height: 1.75;
    max-width: 38rem;
  }

  .block-title {
    margin-bottom: 2rem;
  }

  .story {
    display: grid;
    gap: 2.5rem;
  }

  .chapter {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1.5rem;
  }

  .idx {
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--navy);
    border-top: 6px solid var(--orange);
    padding-top: 0.5rem;
    margin: 0;
  }

  .chapter h3 {
    font-size: var(--step-2);
    margin-bottom: 0.75rem;
  }

  .next {
    margin-top: 2.5rem;
    font-weight: 500;
  }

  .beliefs {
    display: grid;
    gap: 2rem;
  }

  blockquote {
    margin: 0;
    padding-left: 1.5rem;
    border-left: 6px solid var(--orange);
    max-width: 48rem;
  }

  .quote {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: var(--step-2);
    line-height: 1.5;
    color: var(--navy);
    margin-bottom: 0.4rem;
  }

  .media {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .media li {
    display: grid;
    grid-template-columns: 7.5rem 7rem 1fr;
    gap: 0.25rem 1.25rem;
    padding: 0.8rem 0;
    border-top: 1px solid var(--rule);
  }

  .media .date {
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--navy);
  }

  .two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem 4rem;
  }

  .contact {
    padding-left: 1.2em;
  }

  .en-bio p {
    line-height: 1.7;
  }


  .edu-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 2rem 4rem;
  }

  .sub {
    font-size: var(--step-1);
    margin: 0 0 0.75rem;
  }

  .sub:not(:first-child) {
    margin-top: 2rem;
  }

  .edu,
  .pubs,
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .edu li,
  .pubs li,
  .plain li {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.2rem 1rem;
    padding: 0.6rem 0;
    border-top: 1px solid var(--rule);
  }

  .pubs li {
    grid-template-columns: 3.5rem 1fr;
  }

  .plain li {
    display: block;
  }

  .yrs {
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--navy);
  }

  .venue,
  .authors {
    display: block;
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .note {
    font-size: var(--step--1);
  }

  @media (max-width: 760px) {
    .edu-grid {
      grid-template-columns: 1fr;
    }

    .intro-grid {
      grid-template-columns: 1fr;
    }

    .portrait {
      width: min(70%, 16rem);
    }

    .chapter {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }

    .idx {
      font-size: 2rem;
      width: 3rem;
    }

    .media li {
      grid-template-columns: 1fr;
    }

    .two {
      grid-template-columns: 1fr;
    }
  }
</style>
