---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { person, links } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: string;
}

const {
  title,
  description = `${person.intro}${person.motto}`,
  image = '/og.jpg',
  type = 'website',
  published,
} = Astro.props;

const siteTitle = `${person.name} ${person.nameEn}｜${person.realName}`;
const fullTitle = title ? `${title}｜${person.name} ${person.nameEn}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.realName,
  alternateName: [person.name, person.nameEn, person.realNameEn],
  url: Astro.site?.href,
  image: new URL('/images/xjack-portrait.jpg', Astro.site).href,
  jobTitle: 'RQ 跑力共同創辦人暨執行長',
  worksFor: { '@type': 'Organization', name: 'RQ 跑力（RunningQuotient）', url: links.rq.url },
  alumniOf: { '@type': 'CollegeOrUniversity', name: '國立東華大學' },
  sameAs: [links.facebook.url, links.instagram.url, links.medium.url, links.github.url],
};
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={`${person.name}的文章`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#1e3a5f" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_TW" />
    {published && <meta property="article:published_time" content={published} />}
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=LXGW+WenKai+TC:wght@400;700&family=Noto+Sans+TC:wght@400;500;700&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
