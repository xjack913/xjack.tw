---
import Base from '../layouts/Base.astro';
import CharacterCard from '../components/CharacterCard.astro';
import FbFeed from '../components/FbFeed.astro';
import FbPage from '../components/FbPage.astro';
import LapChart from '../components/LapChart.astro';
import PostList from '../components/PostList.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { links, person } from '../data/site';
import { now, nowUpdated } from '../data/now';
import { projects } from '../data/projects';
import { getPosts } from '../lib/blog';
import { achievementStats } from '../lib/milestones';

const allPosts = await getPosts();
const posts = allPosts.slice(0, 4);
const featured = projects.filter((p) => p.featured);
const ach = achievementStats();
---

<Base fullIdentity>
  <section class="hero band">
    <div class="wrap">
      <CharacterCard />
      <p class="motto">{person.motto}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2>每年解鎖的成就</h2>
          <p>
            目前解鎖 <b class="num big">{ach.count}</b> 個成就、累積 <b class="num big">{ach.points}</b> 點成就點數。
          </p>
        </div>
        <a class="more" href="/timeline/">看全部成就</a>
      </div>
      <LapChart />
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head">
        <h2>任務日誌</h2>
        <p class="small">更新於 <span class="num">{nowUpdated}</span></p>
      </div>
      <ol class="quests">
        {
          now.map((q) => (
            <li class="quest">
              <p class="quest-kind">{q.kind}</p>
              <h3>{q.label}</h3>
              <p class="quest-text" set:html={q.text} />
              <p class="quest-progress">
                <span class="dot" aria-hidden="true" />
                {q.progress}
              </p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head channel-head">
        <h2>世界頻道</h2>
        <FbPage />
      </div>
      <FbFeed />
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head">
        <h2>裝備欄</h2>
        <a class="more" href="/projects/">看全部裝備</a>
      </div>
      <div class="items">
        {featured.map((p) => <ProjectRow project={p} compact />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap posts-grid">
      <div>
        <h2>冒險日誌</h2>
        <p class="muted">訓練日誌、比賽心得、馬拉松數據、創業和育兒，十年寫了 {allPosts.length} 篇。</p>
        <p><a class="more" href="/blog/">翻開日誌</a></p>
      </div>
      <PostList posts={posts} compact />
    </div>
  </section>

  <section class="section band contact">
    <div class="wrap read">
      <h2>有事密我</h2>
      <p>
        想找我演講、訪談、合作，或只是想組隊聊天，直接私訊我的{' '}
        <a href={links.facebook.url} rel="noopener" target="_blank">Facebook 粉絲專頁</a>，我會親自回。
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-block: clamp(2rem, 5vw, 4rem) clamp(2rem, 4vw, 3rem);
  }

  .motto {
    margin: 1.75rem 0 0;
    text-align: center;
    font-weight: 700;
    color: var(--navy);
    font-size: var(--step-1);
  }

  .big {
    font-size: 1.5rem;
    color: var(--navy);
  }

  .small {
    font-size: var(--step--1);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 2fr);
    gap: 1.5rem 4rem;
  }

  .quests {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: 1rem;
  }

  .quest {
    background: var(--paper);
    border: var(--frame);
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }

  .quest-kind {
    display: inline-block;
    margin: 0 0 0.25rem;
    padding: 0 0.6rem;
    border-radius: 6px;
    background: var(--orange-soft);
    color: var(--ember);
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .quest h3 {
    margin-bottom: 0.25rem;
  }

  .quest-text {
    margin-bottom: 0.4rem;
  }

  .quest-progress {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--navy);
  }

  .dot {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--orange);
    box-shadow: 0 0 0 3px var(--orange-soft);
  }

  .channel-head {
    align-items: center;
  }

  .items {
    display: grid;
    gap: 1.5rem;
  }

  .contact h2 {
    margin-bottom: 0.75rem;
  }

  @media (max-width: 820px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
