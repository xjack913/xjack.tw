---
// 成就（里程碑）：每一筆是一個解鎖的成就，一般 10 點、傳說級 50 點
import Base from '../layouts/Base.astro';
import AchIcon from '../components/AchIcon.astro';
import { achievementStats, byYear, categories, formatMilestoneDate, pointsOf } from '../lib/milestones';
import type { MilestoneCategory } from '../data/milestones';
import { legacyLinkMap } from '../lib/blog';

const years = [...byYear().entries()];
const stats = achievementStats();
const used = new Set(years.flatMap(([, list]) => list.map((m) => m.cat)));
const filters = Object.entries(categories).filter(([k]) => used.has(k as MilestoneCategory));
// 連到舊部落格、Medium 的成就，若文章已搬來就改連站內
const resolve = await legacyLinkMap();
---

<Base title="成就" description="叉傑克 XJack 從東華新手村、創立 RQ 跑力、當上桐爸到今天解鎖的每一個成就。">
  <section class="section">
    <div class="wrap">
      <header class="page-head">
        <h1>成就</h1>
        <p class="muted read">
          從東華新手村到今天，人生每解鎖一件事就記一筆，能找到當時紀錄的，也一起附上。一般成就 10 點，橘色的傳說級成就 50 點。
        </p>
        <dl class="board">
          <div><dt>已解鎖</dt><dd class="num">{stats.count}</dd></div>
          <div><dt>傳說級</dt><dd class="num">{stats.majors}</dd></div>
          <div><dt>成就點數</dt><dd class="num">{stats.points.toLocaleString('en-US')}</dd></div>
        </dl>
      </header>

      <div class="filters" role="group" aria-label="依成就分類篩選">
        <button type="button" data-filter="all" aria-pressed="true">全部</button>
        {
          filters.map(([k, label]) => (
            <button type="button" data-filter={k} aria-pressed="false">
              {label}
            </button>
          ))
        }
      </div>
      <p class="filter-status muted" aria-live="polite"></p>

      {
        years.map(([year, list]) => (
          <section class="year" id={`y${year}`} aria-labelledby={`h${year}`}>
            <h2 class="year-num num" id={`h${year}`}>
              {year}
            </h2>
            <ol class="achs">
              {list.map((m) => {
                const href = m.link ? resolve(m.link)! : undefined;
                const external = href && !href.startsWith('/');
                return (
                  <li class:list={['ach', { major: m.major }]} data-cat={m.cat}>
                    <span class="badge" aria-hidden="true">
                      <AchIcon cat={m.cat} />
                    </span>
                    <div class="body">
                      <p class="meta">
                        <time class="num">{formatMilestoneDate(m.date)}</time>
                        <span class="cat">{categories[m.cat]}</span>
                        {m.major && <span class="quality legendary">傳說級</span>}
                      </p>
                      <h3>{m.title}</h3>
                      {m.text && <p class="text" set:html={m.text} />}
                      {href && (
                        <p class="link">
                          <a href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener' : undefined}>
                            {m.linkLabel ?? '看紀錄'}
                          </a>
                        </p>
                      )}
                    </div>
                    <span class="pts num" aria-label={`${pointsOf(m)} 點`}>
                      +{pointsOf(m)}
                    </span>
                  </li>
                );
              })}
            </ol>
          </section>
        ))
      }
    </div>
  </section>
</Base>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.filters button')];
  const items = [...document.querySelectorAll<HTMLElement>('.ach')];
  const years = [...document.querySelectorAll<HTMLElement>('.year')];
  const status = document.querySelector<HTMLElement>('.filter-status');

  function apply(filter: string) {
    let shown = 0;
    for (const it of items) {
      const show = filter === 'all' || it.dataset.cat === filter;
      it.hidden = !show;
      if (show) shown++;
    }
    for (const y of years) {
      y.hidden = !y.querySelector('.ach:not([hidden])');
    }
    for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.filter === filter));
    if (status) status.textContent = filter === 'all' ? '' : `這個分類解鎖了 ${shown} 個成就`;
  }

  for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.filter ?? 'all'));
</script>

<style>
  .page-head {
    margin-bottom: 2rem;
  }

  .page-head h1 {
    margin-bottom: 0.6rem;
  }

  .board {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin: 1.5rem 0 0;
  }

  .board div {
    border: var(--frame);
    border-radius: 12px;
    box-shadow: 4px 4px 0 var(--navy);
    padding: 0.5rem 1.25rem;
    min-width: 8.5rem;
  }

  .board div:last-child {
    background: var(--orange-soft);
  }

  .board dt {
    font-weight: 700;
    color: var(--slate);
    font-size: var(--step--1);
  }

  .board dd {
    margin: 0;
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--navy);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .filters button {
    font: inherit;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--navy);
    background: var(--paper);
    border: 2px solid var(--navy);
    border-radius: 8px;
    padding: 0.3rem 1rem;
    cursor: pointer;
    min-height: 44px;
  }

  .filters button:hover {
    background: var(--mist);
  }

  .filters button[aria-pressed='true'] {
    background: var(--navy);
    color: #fff;
    box-shadow: 3px 3px 0 var(--orange);
  }

  .filter-status {
    min-height: 1.85em;
    font-size: var(--step--1);
  }

  .year {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 0 2rem;
    padding-top: 2rem;
  }

  .year[hidden] {
    display: none;
  }

  .year-num {
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
    font-weight: 700;
    line-height: 1;
    color: var(--navy);
    position: sticky;
    top: 1rem;
    align-self: start;
  }

  .achs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .ach {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr) auto;
    gap: 0 1rem;
    align-items: start;
    background: var(--paper);
    border: 2px solid var(--rule);
    border-radius: 12px;
    padding: 0.9rem 1.1rem;
  }

  .ach[hidden] {
    display: none;
  }

  .ach.major {
    border-color: var(--navy);
    box-shadow: 4px 4px 0 var(--orange);
  }

  .badge {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--navy);
    background: var(--mist);
    border: 2px solid var(--navy);
  }

  .major .badge {
    background: var(--orange);
    color: var(--ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    align-items: baseline;
    margin: 0 0 0.1rem;
    line-height: 1.5;
  }

  .meta time {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
  }

  .cat {
    font-size: var(--step--1);
    color: var(--slate);
  }

  h3 {
    font-size: var(--step-1);
    margin-bottom: 0.2rem;
  }

  .major h3 {
    font-size: var(--step-2);
  }

  .text {
    margin-bottom: 0.3rem;
  }

  .link {
    font-weight: 700;
    margin: 0;
  }

  .pts {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--navy);
    background: var(--mist);
    border-radius: 8px;
    padding: 0 0.6rem;
    line-height: 1.7;
  }

  .major .pts {
    background: var(--orange-soft);
    color: var(--ember);
  }

  @media (max-width: 760px) {
    .year {
      grid-template-columns: 1fr;
    }

    .year-num {
      position: static;
      margin-bottom: 1rem;
    }

    .ach {
      grid-template-columns: 2.75rem minmax(0, 1fr);
    }

    .badge {
      width: 2.75rem;
      height: 2.75rem;
    }

    .pts {
      grid-column: 2;
      justify-self: start;
      margin-top: 0.4rem;
    }
  }
</style>
